{
  "name": "draw-the-line",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:lan": "next dev -H 0.0.0.0",
    "build": "npm run validate:data && next build",
    "start": "next start",
    "lint": "eslint",
    "test": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test \"lib/**/*.test.ts\"",
    "validate:data": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/validate-datasets.ts",
    "check:design": "bash scripts/check-design.sh",
    "check": "npm run validate:data && npm run check:design && npm run test && npm run lint",
    "seed": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --env-file-if-exists=.env.local scripts/seed-datasets.ts",
    "seed:crowd-demo": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --env-file-if-exists=.env.local scripts/seed-crowd-demo.ts",
    "seed:demo-players": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --env-file-if-exists=.env.local scripts/seed-demo-players.ts",
    "seed:admin": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --env-file-if-exists=.env.local scripts/seed-admin.ts",
    "db:push": "supabase db push",
    "db:new": "supabase migration new",
    "db:lint": "supabase db lint",
    "import:wb": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/import-worldbank.ts",
    "rotation": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/launch-pool.ts"
  },
  "dependencies": {
    "motion": "^13.1.1",
    "next": "16.3.3",
    "next-auth": "^5.0.0-beta.32",
    "postgres": "^3.4.9",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.3",
    "supabase": "^2.115.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}