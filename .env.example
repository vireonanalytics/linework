# Copy to .env.local and fill in. .env.local is gitignored and must stay that way.
#
# Nothing in here is a public key. DATABASE_URL grants full read/write to every
# table, and SESSION_HASH_SECRET is what keeps hashed user agents from being
# reversible. Neither belongs in NEXT_PUBLIC_* or anywhere the client can see.

# --- Supabase Postgres -------------------------------------------------------
# Supabase dashboard > Connect > Connection string.
#
# The app uses the TRANSACTION POOLER (port 6543). A direct connection opens a
# new Postgres connection per serverless invocation and will exhaust the
# connection limit under real traffic.
#
#   postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
DATABASE_URL=

# --- session hashing ---------------------------------------------------------
# Server-side pepper for hashing user agents and rate-limit keys. Never stored
# in the database. Rotating it permanently severs the link to existing hashes,
# which caps how long any pseudonymous identifier stays useful.
#
# Generate with:  openssl rand -base64 32
SESSION_HASH_SECRET=

# --- auth (NextAuth v5 / Auth.js) --------------------------------------------
# Signs and encrypts session JWTs. Rotating it invalidates every existing
# session (everyone gets logged out) - the same "rotation caps how long a
# secret stays useful" property SESSION_HASH_SECRET has, deliberately.
#
# Generate with:  openssl rand -base64 32
AUTH_SECRET=

# --- development escape hatch ------------------------------------------------
# Lets the API accept guesses on datasets that are not yet verified and active.
# Exists so Phase 3 could be proved end to end before the CDC numbers are
# confirmed. MUST be absent or false in production, or the whole verified-data
# guarantee is off.
ALLOW_UNVERIFIED_DATASETS=true
